{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybertest.example.invalid/schemas/dynamic-validation-plan.schema.json",
  "title": "Cybertest explicit dynamic validation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "candidate_id",
    "candidate_file",
    "tactic_id",
    "route_decision_id",
    "route_status",
    "provider_capability",
    "capability_state",
    "material_ready",
    "missing_materials",
    "policy",
    "controlled_test_object",
    "actions",
    "stop_conditions",
    "rollback_plan"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "plan_status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^DVP-[A-Za-z0-9._-]+$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
    },
    "tactic_id": {
      "type": "string",
      "minLength": 1
    },
    "route_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "route_status": {
      "enum": [
        "matched",
        "matched_with_fallback",
        "blocked_need_material",
        "blocked_need_capability"
      ]
    },
    "resume_requirements_satisfied": {
      "type": "boolean"
    },
    "provider_capability": {
      "enum": [
        "browser.interactive",
        "http.replay",
        "js.cdp",
        "http.capture",
        "oast.callback",
        "cli.http"
      ]
    },
    "provider_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed",
        "configured",
        "reachable",
        "healthy",
        "permitted",
        "material_ready",
        "available",
        "health"
      ],
      "properties": {
        "installed": {"type": "boolean"},
        "configured": {"type": "boolean"},
        "reachable": {"type": "boolean"},
        "healthy": {"type": "boolean"},
        "permitted": {"type": "boolean"},
        "material_ready": {"type": "boolean"},
        "available": {"type": "boolean"},
        "health": {
          "enum": [
            "unknown",
            "installed_only",
            "configured",
            "reachable",
            "degraded",
            "ok",
            "unavailable"
          ]
        }
      }
    },
    "material_ready": {
      "type": "boolean"
    },
    "missing_materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "safe_validation_level"
      ],
      "properties": {
        "permitted": {"type": "boolean"},
        "safe_validation_level": {
          "enum": [
            "readonly",
            "log_confirmation",
            "empty_body",
            "fake_object",
            "test_object",
            "authorized_side_effect"
          ]
        }
      }
    },
    "controlled_test_object": {
      "type": "boolean"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "evidence_id",
          "operation",
          "control_variant",
          "parameters",
          "invariants_checked",
          "rollback_status",
          "evidence_refs",
          "state_change"
        ],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[A-Za-z0-9._-]+$"
          },
          "operation": {"type": "string", "minLength": 1},
          "control_variant": {
            "enum": [
              "baseline",
              "positive-control",
              "negative-control",
              "candidate-probe",
              "readback",
              "rollback"
            ]
          },
          "request_id": {"type": ["string", "null"]},
          "auth_context": {"type": ["string", "null"]},
          "browser_context": {"type": ["string", "null"]},
          "parameters": {"type": "object"},
          "invariants_checked": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "rollback_status": {
            "enum": [
              "not-required",
              "pending",
              "completed",
              "failed",
              "blocked"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^evidence/[A-Za-z0-9._/-]+$"
            }
          },
          "state_change": {"type": "boolean"}
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "steps"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "steps": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
