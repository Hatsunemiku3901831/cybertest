{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybertest.invalid/schemas/candidate.schema.json",
  "title": "Cybertest Candidate v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "asset",
    "candidate_type",
    "priority_score",
    "evidence_confidence",
    "reachability_stage",
    "impact_stage",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^BC-[A-Za-z0-9._-]+$"},
    "name": {"type": "string"},
    "asset": {"type": "string", "minLength": 1},
    "url_or_endpoint": {"type": "string"},
    "http_method": {"type": "string"},
    "route_template": {"type": "string"},
    "candidate_type": {"type": "string", "minLength": 1},
    "business_object": {"type": "string"},
    "business_capability": {"type": "string"},
    "operation_type": {"type": "string"},
    "trust_boundary": {"type": "string"},
    "category": {"type": "string"},
    "technologies": {"type": "array", "items": {"type": "string"}},
    "observed_signals": {"type": "array", "items": {"type": "string"}},
    "suspected_control_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "anonymous_hint": {"type": "boolean"},
    "observed_without_auth": {"type": ["boolean", "null"]},
    "auth_experiment": {
      "type": ["object", "null"],
      "properties": {
        "missing_auth": {"type": ["string", "null"]},
        "fixed_invalid_auth": {"type": ["string", "null"]},
        "controlled_auth": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "priority_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "evidence_confidence": {
      "enum": ["unknown", "weak", "differential", "independently_observed", "reproducible"]
    },
    "reachability_stage": {
      "enum": ["signal", "route", "handler", "business_logic", "object_read", "state_change", "impact"]
    },
    "impact_stage": {
      "enum": ["unknown", "hypothesis", "bounded", "observed", "reproducible"]
    },
    "safe_validation_level": {
      "enum": ["readonly", "log_confirmation", "empty_body", "fake_object", "test_object", "authorized_side_effect"]
    },
    "matched_tactics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score"],
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "match_reasons": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "route_status": {"type": "string"},
    "route_decision_id": {"type": "string"},
    "route_fallback": {"type": ["object", "null"]},
    "validation_contract": {"type": "object"},
    "evidence_envelopes": {
      "type": "array",
      "items": {"type": "object"}
    },
    "negative_controls": {"type": "array", "items": {"type": "string"}},
    "evidence_invariants": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "rollback_plan": {"type": "object"},
    "root_cause_family": {"type": "string"},
    "affected_instance_key": {"type": "string"},
    "reopen_conditions": {"type": "array", "items": {"type": "string"}},
    "missing_materials": {"type": "array", "items": {"type": "string"}},
    "blocked_reason": {"type": "string"},
    "recovery_first_action": {"type": "string"},
    "resume_tactic_id": {"type": "string"},
    "do_not_overclaim": {"type": "string"},
    "status": {
      "enum": [
        "discovered",
        "triaged",
        "plan_ready",
        "verifying",
        "observed",
        "confirmed",
        "blocked_need_material",
        "false_positive",
        "downgraded",
        "no_impact",
        "out_of_scope",
        "archived"
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "status": {"const": "blocked_need_material"},
            "missing_materials": {"type": "array", "minItems": 1},
            "blocked_reason": {"type": "string", "minLength": 1},
            "recovery_first_action": {"type": "string", "minLength": 1},
            "resume_tactic_id": {"type": "string", "minLength": 1},
            "reopen_conditions": {"type": "array", "minItems": 1}
          },
          "required": [
            "missing_materials",
            "blocked_reason",
            "recovery_first_action",
            "resume_tactic_id",
            "reopen_conditions"
          ]
        },
        {
          "properties": {
            "status": {
              "enum": [
                "discovered",
                "triaged",
                "plan_ready",
                "verifying",
                "observed",
                "confirmed",
                "false_positive",
                "downgraded",
                "no_impact",
                "out_of_scope",
                "archived"
              ]
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true
}
