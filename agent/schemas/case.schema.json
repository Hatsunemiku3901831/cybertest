{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cybertest/schemas/case.schema.json",
  "title": "Cybertest anonymized security case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "scene",
    "target_type",
    "technology",
    "business_object",
    "operation_type",
    "trust_boundary",
    "observed_signal",
    "root_cause_family",
    "evidence_mode",
    "required_material",
    "matched_tactics",
    "effective_paths",
    "ineffective_paths",
    "control_gap",
    "request_matrix",
    "false_positive_filters",
    "evidence_invariants",
    "stop_conditions",
    "rollback",
    "sources",
    "anonymization_check"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9][A-Z0-9-]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "summary": {
      "type": "string",
      "minLength": 12
    },
    "scene": {
      "type": "string",
      "minLength": 3
    },
    "target_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "technology": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "business_object": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "operation_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "trust_boundary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "observed_signal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "root_cause_family": {
      "type": "string",
      "minLength": 3
    },
    "evidence_mode": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "required_material": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "matched_tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
      }
    },
    "effective_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 2
      }
    },
    "ineffective_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 2
      }
    },
    "control_gap": {
      "type": "object",
      "minProperties": 3
    },
    "request_matrix": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "minProperties": 4
      }
    },
    "false_positive_filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "evidence_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 6
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "method",
        "success_criteria"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "minLength": 3
        },
        "success_criteria": {
          "type": "string",
          "minLength": 6
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_alias",
          "relative_path",
          "sha256",
          "selection"
        ],
        "properties": {
          "source_alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]+$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selection": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "anonymization_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_on",
        "target_identifiers_removed",
        "replayable_secrets_removed",
        "personal_paths_removed",
        "placeholder_only",
        "scanner"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "target_identifiers_removed": {
          "const": true
        },
        "replayable_secrets_removed": {
          "const": true
        },
        "personal_paths_removed": {
          "const": true
        },
        "placeholder_only": {
          "const": true
        },
        "scanner": {
          "type": "string",
          "minLength": 4
        }
      }
    }
  }
}
